FROM alpine:3.19

LABEL description="NetCert Study Sandbox — lightweight shell for CLI practice"
LABEL maintainer="NetCert Team"

# Install common network diagnostic tools
RUN apk add --no-cache \
    bash \
    iproute2 \
    iputils \
    bind-tools \
    curl \
    wget \
    tcpdump \
    netcat-openbsd \
    busybox-extras \
    vim \
    nano \
    util-linux \
    mtr \
    htop

# Set a friendly shell prompt
ENV PS1='\n\[\e[32m\]┌──(\[\e[1m\]netcert-sandbox\[\e[22m\])-\[\e[36m\][\u@\h]\[\e[0m\]\n\[\e[32m\]└─\[\e[1m\]$ \[\e[0m\]'
ENV TERM=xterm-256color

# Create a welcome banner
RUN echo 'echo -e "\n\033[32m┌─────────────────────────────────────────────────┐\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[1mNetCert Study Sandbox\033[0m\033[32m                                │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[33mПрактикуйте JunOS команды в реальном терминале\033[0m\033[32m    │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m├─────────────────────────────────────────────────┤\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[90mДоступные команды:\033[0m\033[32m                                    │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[37mshow <interface|route|config|log>\033[90m  show commands\033[0m\033[32m  │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[37mping, traceroute, telnet\033[90m          network diag\033[0m\033[32m      │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[37mcurl, wget, nc\033[90m                    HTTP/TCP tools\033[0m\033[32m    │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[37mip, ss, bridge\033[90m                    network config\033[0m\033[32m     │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m│  \033[90mТерминал работает в реальном времени через WebSocket\033[0m\033[32m │\033[0m"' >> /etc/profile && \
    echo 'echo -e "\033[32m└─────────────────────────────────────────────────┘\033[0m"' >> /etc/profile

CMD ["/bin/bash"]
