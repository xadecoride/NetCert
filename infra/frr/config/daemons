# NetCert Pro — FRR Daemons Configuration
# Enables bgpd and ospfd for routing protocol demonstrations

# Watchfrr, zebra and staticd are always started.
#
bgpd=yes
ospfd=yes
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

# Startup options for daemons
#
# If you set any of the options below, be careful of quoting and escaping;
# consider that these are run in a shell environment.
#
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1 -M rpki"
ospfd_options="  -A 127.0.0.1"

# Configuration file to load on startup
# vtysh_enable=yes
#
# If vtysh_enable is yes, the init script will run `vtysh -b` to apply
# the configuration from /etc/frr/frr.conf (and per-daemon configs).
vtysh_enable=yes

# Max number of file descriptors that FRR may reserve.
MAX_FDS=1024
