# ============================================================
# NetCert — необязательные переменные для `docker compose up`
# ============================================================
# Скопируйте в `.env` и измените при необходимости.
# Без этого файла всё работает с dev-значениями по умолчанию.
#
#   cp .env.example .env
#

# ─── База данных ────────────────────────────────────────────
# POSTGRES_DB=netcert
# POSTGRES_USER=netcert
# POSTGRES_PASSWORD=netcert
# POSTGRES_PORT=5432        # хост-порт PostgreSQL

# ─── Redis ──────────────────────────────────────────────────
# REDIS_PORT=6379           # хост-порт Redis

# ─── Backend ────────────────────────────────────────────────
# BACKEND_PORT=8080         # хост-порт API
# JWT_SECRET=netcert-dev-secret-change-in-production

# ─── Frontend ───────────────────────────────────────────────
# FRONTEND_PORT=3000        # хост-порт UI
